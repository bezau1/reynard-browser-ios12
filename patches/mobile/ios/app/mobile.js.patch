-// Use software webrender on simulator due to missing APIs.
+// Firefox add-on support, copied from Android's.
+pref("extensions.isembedded", true);
+pref("extensions.autoDisableScopes", 15);
+pref("extensions.enabledScopes", 5);
+pref("extensions.experiments.enabled", false);
+pref("extensions.getAddons.browseAddons", "https://addons.mozilla.org/%LOCALE%/android/collections/4757633/mob/?page=1&collection_sort=-popularity");
+pref("extensions.getAddons.cache.enabled", true);
+pref("extensions.getAddons.get.url", "https://services.addons.mozilla.org/api/v4/addons/search/?guid=%IDS%&lang=%LOCALE%");
+pref("extensions.getAddons.langpacks.url", "https://services.addons.mozilla.org/api/v4/addons/language-tools/?app=android&type=language&appversion=%VERSION%");
+pref("extensions.getAddons.search.browseURL", "https://addons.mozilla.org/%LOCALE%/android/search?q=%TERMS%&platform=%OS%&appver=%VERSION%");
+pref("extensions.installDistroAddons", false);
+pref("extensions.langpacks.signatures.required", true);
+pref("extensions.logging.enabled", false);
+pref("extensions.manifestV2.actionsPopupURLRestricted", true);
+pref("extensions.strictCompatibility", false);
+pref("extensions.systemAddon.update.enabled", true);
+pref("extensions.systemAddon.update.url", "https://aus5.mozilla.org/update/3/SystemAddons/%VERSION%/%BUILD_ID%/%BUILD_TARGET%/%LOCALE%/%CHANNEL%/%OS_VERSION%/%DISTRIBUTION%/%DISTRIBUTION_VERSION%/update.xml");
+pref("extensions.telemetry.EnvironmentAddonBuilder", true);
+pref("extensions.update.background.url", "https://versioncheck-bg.addons.mozilla.org/update/VersionCheck.php?reqVersion=%REQ_VERSION%&id=%ITEM_ID%&version=%ITEM_VERSION%&maxAppVersion=%ITEM_MAXAPPVERSION%&status=%ITEM_STATUS%&appID=%APP_ID%&appVersion=%APP_VERSION%&appOS=%APP_OS%&appABI=%APP_ABI%&locale=%APP_LOCALE%&currentAppVersion=%CURRENT_APP_VERSION%&updateType=%UPDATE_TYPE%&compatMode=%COMPATIBILITY_MODE%");
+pref("extensions.update.enabled", true);
+pref("extensions.update.interval", 86400);
+pref("extensions.update.url", "https://versioncheck.addons.mozilla.org/update/VersionCheck.php?reqVersion=%REQ_VERSION%&id=%ITEM_ID%&version=%ITEM_VERSION%&maxAppVersion=%ITEM_MAXAPPVERSION%&status=%ITEM_STATUS%&appID=%APP_ID%&appVersion=%APP_VERSION%&appOS=%APP_OS%&appABI=%APP_ABI%&locale=%APP_LOCALE%&currentAppVersion=%CURRENT_APP_VERSION%&updateType=%UPDATE_TYPE%&compatMode=%COMPATIBILITY_MODE%");
+pref("extensions.webextOptionalPermissionPrompts", true);
+pref("extensions.webextensions.early_background_wakeup_on_request", true);
+pref("extensions.dataCollectionPermissions.enabled", true);
+pref("webextensions.storage.sync.kinto", true);
+pref("xpinstall.signatures.required", true);
+pref("xpinstall.whitelist.add", "https://addons.mozilla.org");
+pref("xpinstall.whitelist.fileRequest", false);
+
+// Use software webrender on the simulator, which lacks the GPU APIs hardware
+// webrender needs. On device, use GPU (hardware) webrender in the parent process.
 #if TARGET_OS_SIMULATOR
   pref("gfx.webrender.software", true);
 #endif
 
+// Run compositing in the parent process instead of a GPU child. The child runs
+// as an app extension, which cannot reliably create an OpenGL ES context; the
+// parent is a full app and can, so keep GL/compositing there.
+pref("layers.gpu-process.enabled", false);
+
+// Run networking (including DNS) in the parent process. On iOS the socket
+// process runs as an app extension whose sandbox cannot reach mDNSResponder
+// (/var/run/mDNSResponder), so DNS resolution fails there and every page load
+// reports the host as not found. The parent app has DNS access.
+pref("network.process.enabled", false);
+pref("network.http.network_access_on_socket_process.enabled", false);
+
 // Enable the restricted sandbox for content processes.
 pref("security.sandbox.content.level", 1);
 
+// Allow autoplay configuration
+pref("media.geckoview.autoplay.request", true);
+
+// Enable prelaunching of content processes.
+pref("dom.ipc.processPrelaunch.enabled", true);
+
