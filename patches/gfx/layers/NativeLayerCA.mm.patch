+// Takes ownership of aSpace.
+static CGColorRef CreateCGColorInSpace(CGColorSpaceRef aSpace,
+                                       const gfx::DeviceColor& aColor) {
+  CGFloat components[] = {aColor.r, aColor.g, aColor.b, aColor.a};
+  CGColorRef color = CGColorCreate(aSpace, components);
+  CGColorSpaceRelease(aSpace);
+  return color;
+}
+
