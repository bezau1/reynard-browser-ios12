+                                aColor);
   }
 
-  return CGColorCreateGenericRGB(aColor.r, aColor.g, aColor.b, aColor.a);
+  if (__builtin_available(iOS 13.0, *)) {
+    return CGColorCreateGenericRGB(aColor.r, aColor.g, aColor.b, aColor.a);
+  }
+  return CreateCGColorInSpace(CGColorSpaceCreateDeviceRGB(), aColor);
 }
 
