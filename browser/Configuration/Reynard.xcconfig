CURRENT_VERSION = 0.16.0
CURRENT_BUILD = UNKNOWN
APP_DISPLAY_NAME = Reynard

IPHONEOS_DEPLOYMENT_TARGET = 12.0
ARCHS = arm64
VALID_ARCHS = arm64

ENABLE_BITCODE = NO

GECKO_DIST = $(SRCROOT)/../engine/firefox/obj-aarch64-apple-ios/dist

HEADER_SEARCH_PATHS = $(inherited) $(GECKO_DIST)/include $(GECKO_DIST)/include/GeckoView $(SRCROOT)/GeckoView
LIBRARY_SEARCH_PATHS = $(inherited) $(GECKO_DIST)/bin
FRAMEWORK_SEARCH_PATHS = $(inherited) $(BUILT_PRODUCTS_DIR)
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Reynard/Bridging/Reynard-Bridging-Header.h

// Swift's official concurrency back-deployment only guarantees iOS 13+; below that
// the compiler hard-errors on async/await/@MainActor even though the back-deploy
// runtime dylib bundled with the app actually runs fine on iOS 12. This flag tells
// the frontend to stop enforcing the iOS 13 availability floor for these APIs.
OTHER_SWIFT_FLAGS = $(inherited) -Xfrontend -disable-availability-checking
